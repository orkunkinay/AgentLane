{
  "manifest_version": 3,
  "name": "AgentLane",
  "version": "0.1.0",
  "description": "Experimental target-scoped visual input in a dedicated authenticated window.",
  "permissions": ["debugger", "nativeMessaging", "storage"],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "setup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
