{
  "name": "agentlane",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "AgentLane: visual AI browser lanes in your authenticated Chrome without sharing desktop input",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:browser": "node experiments/browser.mjs",
    "mcp": "node src/mcp.js",
    "format": "prettier --write src extension scripts experiments test package.json",
    "format:check": "prettier --check src extension scripts experiments test package.json",
    "check": "node scripts/check.mjs",
    "pretest": "npm run check",
    "check:site": "node scripts/check-site.mjs",
    "site": "python3 -m http.server 4173",
    "package:extension": "node scripts/package-extension.mjs",
    "assets:store": "node scripts/capture-docs.mjs && node scripts/render-store-assets.mjs",
    "doctor": "node scripts/doctor.mjs",
    "bench": "node experiments/benchmark/cli.mjs",
    "test:reliability": "node experiments/reliability.mjs",
    "test:recovery": "node experiments/recovery.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "playwright": "^1.56.0",
    "prettier": "^3.10.1"
  }
}
